<Window x:Class="MailClient.App.Views.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MailClient.App.ViewModels"
        Style="{StaticResource AppWindow}" Title="Правила пересылки" Icon="/Assets/app.ico"
        Width="680" Height="600" MinWidth="520" MinHeight="420" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="Сохранить" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="110" Click="Save_Click" IsEnabled="False"/>
                    <Button Content="Отмена" IsCancel="True" MinWidth="90" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
        <DockPanel Margin="24,16,24,12">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Правила пересылки и переадресации" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Правила выполняет почтовый сервер, даже когда программа закрыта. Они проверяются сверху вниз."/>
                <Border x:Name="NoteBanner" Background="{DynamicResource Brush.Banner}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="NoteText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.BannerText}"/>
                </Border>
            </StackPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="-4,12,0,6" x:Name="Toolbar" IsEnabled="False">
                <Button Style="{StaticResource ToolButton}" Tag="&#xE710;" Content="Новое правило" Click="Add_Click"/>
                <Button x:Name="EditButton" Style="{StaticResource ToolButton}" Tag="&#xE70F;" Content="Изменить" Click="Edit_Click"/>
                <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Tag="&#xE74D;" Content="Удалить" Click="Delete_Click"/>
                <Rectangle Width="1" Height="20" Margin="6,0" Fill="{DynamicResource Brush.Border}"/>
                <Button x:Name="UpButton" Style="{StaticResource ToolButton}" Tag="&#xE70E;" ToolTip="Выше (проверяется раньше)" Click="Up_Click"/>
                <Button x:Name="DownButton" Style="{StaticResource ToolButton}" Tag="&#xE70D;" ToolTip="Ниже (проверяется позже)" Click="Down_Click"/>
            </WrapPanel>
            <Grid>
                <ListBox x:Name="List" AutomationProperties.Name="Правила" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RuleItemViewModel}">
                            <DockPanel Margin="2,8,8,8" Background="Transparent">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" VerticalAlignment="Top" Margin="0,2,10,0"
                                          ToolTip="Правило включено" AutomationProperties.Name="{Binding Name}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Text="Загрузка правил с сервера…"/>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
