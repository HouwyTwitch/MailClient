<Window x:Class="MailClient.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="LabelText" TextWrapping="Wrap"/>
        <TextBox x:Name="ValueBox" Margin="0,8,0,0" AutomationProperties.LabeledBy="{Binding ElementName=LabelText}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="ОК" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="90" Click="Ok_Click"/>
            <Button Content="Отмена" IsCancel="True" MinWidth="90" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
