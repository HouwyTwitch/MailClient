<Window x:Class="MailClient.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MailClient.App.ViewModels"
        xmlns:ctl="clr-namespace:MailClient.App.Controls"
        Style="{StaticResource AppWindow}"
        Title="{Binding WindowTitle}" Icon="/Assets/app.ico"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewMessageCommand}"/>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding ReplyCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding ReplyAllCommand}"/>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding ForwardCommand}"/>
        <KeyBinding Gesture="Ctrl+Q" Command="{Binding MarkReadCommand}"/>
        <KeyBinding Gesture="Ctrl+U" Command="{Binding MarkUnreadCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+V" Command="{Binding MoveToCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveAsEmlCommand}"/>
        <KeyBinding Key="Insert" Command="{Binding ToggleFlagCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="F9" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================= navigation rail -->
        <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE715;" Content="Почта" ToolTip="Почта"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumEquals}, ConverterParameter=Mail}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE787;" Content="Календарь" ToolTip="Календарь"
                                 Visibility="{Binding SupportsCalendar, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumEquals}, ConverterParameter=Calendar}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE77B;" Content="Контакты" ToolTip="Контакты и адресная книга"
                                 Visibility="{Binding SupportsContacts, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumEquals}, ConverterParameter=Contacts}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9D5;" Content="Задачи" ToolTip="Задачи"
                                 Visibility="{Binding SupportsTasks, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumEquals}, ConverterParameter=Tasks}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE9CA;" ToolTip="Автоответ (нет на месте)" HorizontalAlignment="Center"
                            Visibility="{Binding SupportsOutOfOffice, Converter={StaticResource BoolToVis}}"
                            Command="{Binding OpenOutOfOfficeCommand}"/>
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE713;" ToolTip="Параметры" HorizontalAlignment="Center">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Параметры программы…" Command="{Binding OpenSettingsCommand}"/>
                                <Separator/>
                                <MenuItem Header="Добавить учётную запись…" Command="{Binding AddAccountCommand}"/>
                                <MenuItem Header="Настройки учётной записи…" Command="{Binding EditCurrentAccountCommand}"/>
                                <MenuItem Header="Удалить учётную запись…" Command="{Binding RemoveCurrentAccountCommand}"/>
                                <Separator/>
                                <MenuItem Header="Автоответ (нет на месте)…" Command="{Binding OpenOutOfOfficeCommand}"/>
                                <MenuItem Header="Открыть папку журналов" Command="{Binding OpenLogsCommand}"/>
                                <MenuItem Header="О программе" Command="{Binding ShowAboutCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================= MAIL -->
        <Grid Grid.Column="1" Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Mail}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FolderColumn" Width="250" MinWidth="170"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ListColumn" Width="400" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- folder pane -->
            <DockPanel Background="{DynamicResource Brush.SurfaceAlt}">
                <Button DockPanel.Dock="Top" Style="{StaticResource AccentButton}" Margin="12,12,12,8" Height="36"
                        Command="{Binding NewMessageCommand}" ToolTip="Новое письмо (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Foreground="{DynamicResource Brush.AccentText}"/>
                        <TextBlock Text="Новое письмо" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <TreeView x:Name="FolderTree" ItemsSource="{Binding Roots}" Padding="4,0,4,8" AllowDrop="True"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"
                          PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown"
                          DragOver="FolderTree_DragOver" DragLeave="FolderTree_DragLeave" Drop="FolderTree_Drop">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                            <Border x:Name="row" Background="Transparent" CornerRadius="4"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="14" Margin="2,0,8,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBlock x:Name="name" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Unread}" Margin="8,0,6,0" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"
                                               Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Новая папка…" Command="{Binding PlacementTarget.Tag.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Переименовать…" Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding CanModify}"/>
                                        <MenuItem Header="Переместить…" Command="{Binding PlacementTarget.Tag.MoveFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding CanModify}"/>
                                        <MenuItem Header="Удалить папку" Command="{Binding PlacementTarget.Tag.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding CanModify}"/>
                                        <Separator/>
                                        <MenuItem Header="Отметить все как прочитанные" Command="{Binding PlacementTarget.Tag.MarkFolderReadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Очистить папку…" Command="{Binding PlacementTarget.Tag.EmptyFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Импортировать письма (.eml)…" Command="{Binding PlacementTarget.Tag.ImportEmlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="Обновить" Command="{Binding PlacementTarget.Tag.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                    <Setter TargetName="name" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAccountRoot}" Value="True">
                                    <Setter TargetName="name" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource Brush.Border}" BorderBrush="{DynamicResource Brush.Window}" BorderThickness="2,0"/>

            <!-- message list -->
            <DockPanel Grid.Column="2" Background="{DynamicResource Brush.Surface}">
                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,6">
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,5,28,5"
                                 ToolTip="Поиск в текущей папке (Ctrl+E). Нажмите Enter для поиска.">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" HorizontalAlignment="Left" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}" IsHitTestVisible="False"/>
                        <TextBlock Text="Поиск" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Visibility="{Binding SearchText, Converter={StaticResource InvBoolToVis}}"/>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE711;" HorizontalAlignment="Right" MinHeight="24" Padding="6,2"
                                Command="{Binding ClearSearchCommand}" ToolTip="Сбросить поиск"
                                Visibility="{Binding SearchText, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <DockPanel Margin="2,10,0,0">
                        <TextBlock Text="{Binding FolderTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="  · результаты поиска" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                   Visibility="{Binding IsSearchResult, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>
                </StackPanel>

                <Grid>
                    <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"
                             SelectionMode="Extended" SelectionChanged="MessageList_SelectionChanged"
                             PreviewMouseLeftButtonDown="MessageList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="MessageList_PreviewMouseMove"
                             MouseDoubleClick="MessageList_MouseDoubleClick"
                             ScrollViewer.ScrollChanged="MessageList_ScrollChanged"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
                            <KeyBinding Gesture="Shift+Delete" Command="{Binding DeleteCommand}" CommandParameter="permanent"/>
                            <KeyBinding Key="Enter" Command="{Binding OpenSelectedCommand}"/>
                        </ListBox.InputBindings>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть" Command="{Binding OpenSelectedCommand}" InputGestureText="Enter"/>
                                <Separator/>
                                <MenuItem Header="Ответить" Command="{Binding ReplyCommand}" InputGestureText="Ctrl+R"/>
                                <MenuItem Header="Ответить всем" Command="{Binding ReplyAllCommand}" InputGestureText="Ctrl+Shift+R"/>
                                <MenuItem Header="Переслать" Command="{Binding ForwardCommand}" InputGestureText="Ctrl+F"/>
                                <Separator/>
                                <MenuItem Header="Отметить как прочитанное" Command="{Binding MarkReadCommand}" InputGestureText="Ctrl+Q"/>
                                <MenuItem Header="Отметить как непрочитанное" Command="{Binding MarkUnreadCommand}" InputGestureText="Ctrl+U"/>
                                <MenuItem Header="Флажок" Command="{Binding ToggleFlagCommand}" InputGestureText="Insert"/>
                                <MenuItem Header="Отметить флажок как выполненный" Command="{Binding MarkFlagCompleteCommand}"/>
                                <Separator/>
                                <MenuItem Header="Переместить в папку…" Command="{Binding MoveToCommand}" InputGestureText="Ctrl+Shift+V"/>
                                <MenuItem Header="Копировать в папку…" Command="{Binding CopyToCommand}"/>
                                <MenuItem Header="Нежелательная почта" Command="{Binding MarkAsJunkCommand}"/>
                                <Separator/>
                                <MenuItem Header="Сохранить как .eml…" Command="{Binding SaveAsEmlCommand}" InputGestureText="Ctrl+S"/>
                                <Separator/>
                                <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" InputGestureText="Delete"/>
                                <MenuItem Header="Удалить безвозвратно" Command="{Binding DeleteCommand}" CommandParameter="permanent" InputGestureText="Shift+Delete"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MessageItemViewModel}">
                                <Grid Margin="0,8,10,8" Background="Transparent" ToolTip="{Binding DateTooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.RowSpan="3" Width="3" CornerRadius="2" Margin="0,2,7,2" HorizontalAlignment="Right"
                                            Background="{DynamicResource Brush.Accent}"
                                            Visibility="{Binding IsRead, Converter={StaticResource InvBoolToVis}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Correspondent}" TextTrimming="CharacterEllipsis" FontSize="14"
                                               FontWeight="{Binding IsRead, Converter={StaticResource UnreadWeight}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="subject" Grid.Row="1" Grid.Column="1" Text="{Binding Subject}" TextTrimming="CharacterEllipsis"
                                               FontWeight="{Binding IsRead, Converter={StaticResource UnreadWeight}}"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="12" Margin="6,0,0,0" ToolTip="Приглашение на встречу"
                                                   Visibility="{Binding IsMeeting, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C9;" FontSize="12" Margin="6,0,0,0" ToolTip="Высокая важность"
                                                   Foreground="{DynamicResource Brush.Danger}" Visibility="{Binding IsHighImportance, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE723;" FontSize="12" Margin="6,0,0,0" ToolTip="Есть вложения"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7C1;" FontSize="12" Margin="6,0,0,0" ToolTip="С флажком"
                                                   Foreground="{DynamicResource Brush.Flag}" Visibility="{Binding IsFlagged, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Preview}" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                               Visibility="{Binding Preview, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRead}" Value="False">
                                        <Setter TargetName="subject" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding ListStatus}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="20,40,20,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                               Visibility="{Binding ListStatus, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource Brush.Border}" BorderBrush="{DynamicResource Brush.Window}" BorderThickness="2,0"/>

            <!-- reading pane -->
            <DockPanel Grid.Column="4" Background="{DynamicResource Brush.Surface}">
                <!-- command bar -->
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                    <WrapPanel>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE8CA;" Content="Ответить" Command="{Binding ReplyCommand}" ToolTip="Ответить (Ctrl+R)"/>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE8C2;" Content="Ответить всем" Command="{Binding ReplyAllCommand}" ToolTip="Ответить всем (Ctrl+Shift+R)"/>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE89C;" Content="Переслать" Command="{Binding ForwardCommand}" ToolTip="Переслать (Ctrl+F)"/>
                        <Rectangle Width="1" Height="20" Margin="6,0" Fill="{DynamicResource Brush.Border}"/>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE74D;" Content="Удалить" Command="{Binding DeleteCommand}" ToolTip="Удалить (Delete)"/>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE8DE;" Content="Переместить" Command="{Binding MoveToCommand}" ToolTip="Переместить в папку"/>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE7BA;" Command="{Binding MarkAsJunkCommand}" ToolTip="В нежелательную почту"/>
                        <Rectangle Width="1" Height="20" Margin="6,0" Fill="{DynamicResource Brush.Border}"/>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE8C3;" Command="{Binding MarkReadCommand}" ToolTip="Отметить как прочитанное (Ctrl+Q)"/>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE715;" Command="{Binding MarkUnreadCommand}" ToolTip="Отметить как непрочитанное (Ctrl+U)"/>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE7C1;" Command="{Binding ToggleFlagCommand}" ToolTip="Флажок (Insert)"/>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE749;" Click="Print_Click" ToolTip="Печать"/>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Обновить (F5)"/>
                    </WrapPanel>
                </Border>

                <Grid>
                    <TextBlock Text="Выберите письмо для просмотра" Style="{StaticResource Caption}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasPreview, Converter={StaticResource InvBoolToVis}}"/>
                    <DockPanel DataContext="{Binding Preview}" Visibility="{Binding DataContext.HasPreview, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <!-- header -->
                        <StackPanel DockPanel.Dock="Top" Margin="20,16,20,8">
                            <TextBlock Text="{Binding Subject}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding FromInitials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DateText}" Style="{StaticResource Caption}" Margin="8,2,0,0"/>
                                        <TextBox Text="{Binding FromText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 Padding="0" MinHeight="0" FontWeight="SemiBold" FontSize="14"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding OnBehalfText}" Style="{StaticResource Caption}" Visibility="{Binding IsSentOnBehalf, Converter={StaticResource BoolToVis}}"/>
                                    <DockPanel Margin="0,3,0,0">
                                        <TextBlock Text="Кому: " Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding ToText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                                 MinHeight="0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </DockPanel>
                                    <DockPanel Visibility="{Binding HasCc, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Копия: " Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding CcText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                                 MinHeight="0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </DockPanel>
                                    <TextBlock Text="Высокая важность" Foreground="{DynamicResource Brush.Danger}" FontSize="12" Margin="0,3,0,0"
                                               Visibility="{Binding IsHighImportance, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- meeting request -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="20,4,20,6" Padding="12,10"
                                Visibility="{Binding IsMeetingRequest, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="20" Margin="0,0,12,0" Foreground="{DynamicResource Brush.Accent}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Принять" Style="{StaticResource AccentButton}" Margin="4,0" Command="{Binding RespondCommand}" CommandParameter="Accept"/>
                                    <Button Content="Под вопросом" Margin="4,0" Command="{Binding RespondCommand}" CommandParameter="Tentative"/>
                                    <Button Content="Отклонить" Margin="4,0" Command="{Binding RespondCommand}" CommandParameter="Decline"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Приглашение на встречу" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MeetingText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Banner}" Margin="20,4,20,6" Padding="12,8" CornerRadius="6"
                                Visibility="{Binding IsMeetingCancellation, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Встреча отменена организатором." Foreground="{DynamicResource Brush.BannerText}"/>
                        </Border>

                        <!-- blocked remote content -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Banner}" Margin="20,4,20,6" Padding="12,6" CornerRadius="6"
                                Visibility="{Binding ShowRemoteBanner, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Показать изображения" Margin="4,0" Padding="10,3" MinHeight="26" Command="{Binding ShowRemoteContentCommand}"/>
                                    <Button Content="Всегда для этого отправителя" Margin="4,0" Padding="10,3" MinHeight="26" Command="{Binding TrustSenderCommand}"/>
                                </StackPanel>
                                <TextBlock Text="Изображения из интернета заблокированы для защиты конфиденциальности." VerticalAlignment="Center"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.BannerText}"/>
                            </DockPanel>
                        </Border>

                        <!-- attachments -->
                        <DockPanel DockPanel.Dock="Top" Margin="18,2,18,8" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Tag="&#xE896;" Content="Сохранить все"
                                    VerticalAlignment="Top" Command="{Binding SaveAllAttachmentsCommand}"/>
                            <ItemsControl ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AttachmentItemViewModel}">
                                        <Border Style="{StaticResource Card}" Margin="2" Padding="0" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource ToolButton}" Tag="{Binding Icon}" ToolTip="Открыть"
                                                        Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel MaxWidth="220">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource ToolButton}" Tag="&#xE896;" ToolTip="Сохранить как…" Padding="6,4"
                                                        Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                            <ctl:MessageBodyView x:Name="BodyView" Html="{Binding Html}"/>
                        </Border>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- ================================================= CALENDAR -->
        <Grid Grid.Column="1" DataContext="{Binding Calendar}" Background="{DynamicResource Brush.Surface}"
              Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Calendar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding NewEventCommand}" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Foreground="{DynamicResource Brush.AccentText}"/>
                                <TextBlock Text="Новое событие" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE76B;" Command="{Binding PreviousCommand}" ToolTip="Предыдущая неделя"/>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE76C;" Command="{Binding NextCommand}" ToolTip="Следующая неделя"/>
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE8D1;" Content="Сегодня" Command="{Binding TodayCommand}"/>
                        <TextBlock Text="{Binding RangeText}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Tag="&#xE72C;" Command="{Binding LoadCommand}" ToolTip="Обновить"
                                HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="14,6"/>
                <ItemsControl ItemsSource="{Binding Days}" Margin="8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CalendarDayViewModel}">
                            <Border x:Name="card" Style="{StaticResource Card}" Margin="4" Padding="6">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="4,2,2,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Tag="&#xE710;" Padding="4,2" MinHeight="24"
                                                ToolTip="Новое событие в этот день"
                                                Command="{Binding DataContext.NewEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Date}"/>
                                        <Border x:Name="num" Width="30" Height="30" CornerRadius="15" Background="Transparent">
                                            <TextBlock x:Name="numText" Text="{Binding DayNumber}" FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="dayName" Text="{Binding DayName}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </DockPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Events}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CalendarEventViewModel}">
                                                    <Button Margin="0,0,0,4" Padding="0" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                            Command="{Binding DataContext.Calendar.SelectEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="chip" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="5"
                                                                        BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="3,0,0,0" Padding="7,5">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="chip" Property="Opacity" Value="0.85"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <StackPanel>
                                                            <TextBlock x:Name="subj" Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="36"
                                                                       Foreground="{DynamicResource Brush.Text}"/>
                                                            <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                            <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                                                       TextTrimming="CharacterEllipsis" Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                            <Setter TargetName="subj" Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="num" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                    <Setter TargetName="numText" Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                    <Setter TargetName="card" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                    <Setter TargetName="dayName" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- event details -->
            <Border Grid.Column="1" Width="320" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0" Padding="20"
                    Background="{DynamicResource Brush.Surface}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding SelectedEvent}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Tag="&#xE711;" ToolTip="Закрыть"
                                Command="{Binding DataContext.Calendar.SelectEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <TextBlock Text="{Binding Subject}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Text="{Binding DateText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding RecurrenceText}" Style="{StaticResource Caption}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE707;" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Location}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="Организатор" Style="{StaticResource FieldLabel}" Visibility="{Binding OrganizerText, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding OrganizerText}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ResponseText}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    <WrapPanel Margin="0,16,0,0" Visibility="{Binding CanRespond, Converter={StaticResource BoolToVis}}">
                        <Button Content="Принять" Style="{StaticResource AccentButton}" Margin="0,0,6,6"
                                Command="{Binding DataContext.Calendar.RespondCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Accept"/>
                        <Button Content="Под вопросом" Margin="0,0,6,6"
                                Command="{Binding DataContext.Calendar.RespondCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Tentative"/>
                        <Button Content="Отклонить" Margin="0,0,6,6"
                                Command="{Binding DataContext.Calendar.RespondCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Decline"/>
                    </WrapPanel>
                    <Button Content="Удалить / отменить" Margin="0,12,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.Danger}"
                            Command="{Binding DataContext.Calendar.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================= CONTACTS -->
        <Grid Grid.Column="1" DataContext="{Binding Contacts}" Background="{DynamicResource Brush.Surface}"
              Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Contacts}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Background="{DynamicResource Brush.SurfaceAlt}">
                <StackPanel DockPanel.Dock="Top" Margin="12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Tag="&#xE72C;" Command="{Binding LoadCommand}" ToolTip="Обновить"/>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding NewContactCommand}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FA;" FontSize="13" Foreground="{DynamicResource Brush.AccentText}"/>
                                <TextBlock Text="Новый контакт" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <TextBox Margin="0,12,0,0" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Фильтр по моим контактам. Enter — поиск в адресной книге организации.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchDirectoryCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Margin="0,6,0,0" HorizontalAlignment="Left" Command="{Binding SearchDirectoryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12"/>
                            <TextBlock Text="Найти в адресной книге организации" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="2,8,0,0"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ContactItemViewModel}">
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Brush.AccentSoft}">
                                    <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="32,28" DataContext="{Binding Selected}" MaxWidth="640" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Brush.AccentSoft}">
                            <TextBlock Text="{Binding Initials}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBox Text="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                     FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13"/>
                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>
                    <WrapPanel Margin="0,18,0,0">
                        <Button Style="{StaticResource AccentButton}" Margin="0,0,8,8"
                                Command="{Binding DataContext.Contacts.WriteEmailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE715;" FontSize="13" Foreground="{DynamicResource Brush.AccentText}"/>
                                <TextBlock Text="Написать письмо" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Изменить" Margin="0,0,8,8"
                                Visibility="{Binding DataContext.Contacts.CanEdit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.Contacts.EditContactCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="Удалить" Margin="0,0,8,8" Foreground="{DynamicResource Brush.Danger}"
                                Visibility="{Binding DataContext.Contacts.CanEdit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.Contacts.DeleteContactCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="Добавить в мои контакты" Margin="0,0,8,8"
                                Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.Contacts.SaveToContactsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </WrapPanel>
                    <TextBlock Text="Электронная почта" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Emails, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap"/>
                    <TextBlock Text="Телефоны" Style="{StaticResource FieldLabel}" Visibility="{Binding Phones, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Text="{Binding Phones, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap"
                             Visibility="{Binding Phones, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Подразделение" Style="{StaticResource FieldLabel}" Visibility="{Binding Department, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Department}" Visibility="{Binding Department, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================================================= TASKS -->
        <DockPanel Grid.Column="1" DataContext="{Binding Tasks}" Background="{DynamicResource Brush.Surface}"
                   Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Tasks}">
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Tag="&#xE72C;" Command="{Binding LoadCommand}" ToolTip="Обновить"/>
                        <CheckBox DockPanel.Dock="Right" Content="Показывать завершённые" IsChecked="{Binding ShowCompleted}" Margin="0,0,12,0"/>
                        <TextBlock Text="Задачи" FontSize="19" FontWeight="SemiBold"/>
                    </DockPanel>
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Добавить" Command="{Binding AddCommand}" Margin="8,0,0,0"/>
                        <DatePicker DockPanel.Dock="Right" SelectedDate="{Binding NewDueDate}" Width="140" Margin="8,0,0,0" ToolTip="Срок выполнения"
                                    VerticalContentAlignment="Center"/>
                        <TextBox Text="{Binding NewSubject, UpdateSourceTrigger=PropertyChanged}" ToolTip="Новая задача — введите текст и нажмите Enter">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="16,6"/>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="8">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TaskItemViewModel}">
                        <Grid Margin="8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsComplete}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Отметить как выполненную"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="subj" Text="{Binding Subject}" TextWrapping="Wrap" FontSize="14"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="due" Text="{Binding DueText}" Style="{StaticResource Caption}" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource ToolButton}" Tag="&#xE74D;" ToolTip="Удалить задачу"
                                    Command="{Binding DataContext.Tasks.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                <Setter TargetName="subj" Property="TextDecorations" Value="Strikethrough"/>
                                <Setter TargetName="subj" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                <Setter TargetName="due" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ================================================= status bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="12,4">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="OnlineDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#2DA44E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                    <Setter Property="Fill" Value="#D29922"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
