<Window x:Class="MailClient.App.Views.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Учётная запись" Icon="/Assets/app.ico"
        Width="620" Height="760" MinHeight="520" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="Сохранить" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="110" Click="Save_Click"/>
                    <Button Content="Отмена" IsCancel="True" MinWidth="90" Margin="8,0,0,0"/>
                </StackPanel>
                <Button x:Name="TestButton" Content="Проверить подключение" Click="Test_Click" HorizontalAlignment="Left"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,20">
                <TextBlock x:Name="HeaderText" Text="Подключение к Microsoft Exchange" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="13"
                           Text="Укажите адрес электронной почты и пароль. Сервер будет найден автоматически; если это не удастся, уточните адрес EWS у администратора."/>

                <TextBlock Text="Тип сервера" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ProtocolCombo" SelectionChanged="ProtocolCombo_SelectionChanged">
                    <ComboBoxItem Content="Microsoft Exchange (почта, календарь, контакты, задачи)" Tag="Exchange"/>
                    <ComboBoxItem Content="IMAP / SMTP (Яндекс 360, Mail.ru, другие почтовые серверы)" Tag="Imap"/>
                </ComboBox>

                <TextBlock Text="Адрес электронной почты" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="EmailBox" LostFocus="EmailBox_LostFocus"/>

                <TextBlock Text="Ваше имя (для отображения)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DisplayNameBox"/>

                <StackPanel x:Name="AuthPanel">
                    <TextBlock Text="Аутентификация" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="AuthCombo" SelectionChanged="AuthCombo_SelectionChanged">
                        <ComboBoxItem Content="NTLM (рекомендуется)" Tag="Ntlm"/>
                        <ComboBoxItem Content="Обычный пароль (Basic)" Tag="Basic"/>
                        <ComboBoxItem Content="Kerberos (Negotiate)" Tag="Negotiate"/>
                        <ComboBoxItem Content="Автоматически (Kerberos → NTLM → Basic)" Tag="Auto"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="SsoHint" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                <StackPanel x:Name="PasswordPanel">
                    <TextBlock Text="Имя пользователя" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UserBox" ToolTip="Например: ДОМЕН\ivanov, ivanov@corp.local или адрес почты"/>
                    <TextBlock x:Name="UserHint" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" Text="Логин Windows (ДОМЕН\логин или логин@домен). Он может отличаться от адреса почты."/>
                    <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox"/>
                    <DockPanel Margin="0,3,0,0">
                        <Button x:Name="ForgetPasswordButton" DockPanel.Dock="Right" Content="Забыть сохранённый пароль" Padding="8,2" MinHeight="24"
                                Margin="8,0,0,0" Click="ForgetPassword_Click" Visibility="Collapsed"/>
                        <TextBlock x:Name="PasswordHint" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Пароль хранится только на этом компьютере в зашифрованном виде (Windows DPAPI)."/>
                    </DockPanel>
                </StackPanel>

                <StackPanel x:Name="ExchangePanel">
                <TextBlock Text="Сервер" Style="{StaticResource SectionHeader}" Margin="0,22,0,0"/>
                <TextBlock Text="Адрес EWS" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <Button x:Name="DiscoverButton" DockPanel.Dock="Right" Content="Найти автоматически" Margin="8,0,0,0" Click="Discover_Click"/>
                    <TextBox x:Name="EwsBox" ToolTip="Обычно https://mail.ваш-домен.ru/EWS/Exchange.asmx"/>
                </DockPanel>
                <TextBlock x:Name="DiscoverStatus" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="Версия Exchange" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="VersionCombo">
                    <ComboBoxItem Content="Exchange 2016 / 2019 / Subscription Edition (рекомендуется)" Tag="Exchange2016"/>
                    <ComboBoxItem Content="Exchange 2013 SP1" Tag="Exchange2013_SP1"/>
                    <ComboBoxItem Content="Exchange 2013" Tag="Exchange2013"/>
                    <ComboBoxItem Content="Exchange 2010 SP2 / SP3" Tag="Exchange2010_SP2"/>
                </ComboBox>
                </StackPanel>

                <StackPanel x:Name="ImapPanel" Visibility="Collapsed">
                    <TextBlock Text="Серверы" Style="{StaticResource SectionHeader}" Margin="0,22,0,0"/>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Заполнить по адресу" Margin="8,0,0,0" Click="Preset_Click"
                                ToolTip="Подставить настройки для Яндекс 360, Mail.ru или стандартные imap./smtp. адреса домена"/>
                        <ComboBox x:Name="PresetCombo" SelectionChanged="PresetCombo_SelectionChanged">
                            <ComboBoxItem Content="Выберите почтовую службу…" Tag=""/>
                            <ComboBoxItem Content="Яндекс 360 / Яндекс Почта" Tag="yandex"/>
                            <ComboBoxItem Content="Mail.ru / VK WorkSpace" Tag="mailru"/>
                            <ComboBoxItem Content="Rambler" Tag="rambler"/>
                            <ComboBoxItem Content="Microsoft Exchange по IMAP" Tag="exchange"/>
                        </ComboBox>
                    </DockPanel>

                    <TextBlock Text="Входящая почта (IMAP)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ImapHostBox" ToolTip="Например: imap.yandex.ru"/>
                        <TextBox x:Name="ImapPortBox" Grid.Column="2" ToolTip="Порт"/>
                        <ComboBox x:Name="ImapSecurityCombo" Grid.Column="4" SelectionChanged="Security_SelectionChanged">
                            <ComboBoxItem Content="SSL/TLS" Tag="SslOnConnect"/>
                            <ComboBoxItem Content="STARTTLS" Tag="StartTls"/>
                            <ComboBoxItem Content="Без шифрования" Tag="None"/>
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="Исходящая почта (SMTP)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SmtpHostBox" ToolTip="Например: smtp.yandex.ru"/>
                        <TextBox x:Name="SmtpPortBox" Grid.Column="2" ToolTip="Порт"/>
                        <ComboBox x:Name="SmtpSecurityCombo" Grid.Column="4" SelectionChanged="Security_SelectionChanged">
                            <ComboBoxItem Content="SSL/TLS" Tag="SslOnConnect"/>
                            <ComboBoxItem Content="STARTTLS" Tag="StartTls"/>
                            <ComboBoxItem Content="Без шифрования" Tag="None"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="SaveSentCheck" Content="Сохранять копии отправленных писем в папке «Отправленные»" Margin="0,10,0,0"/>
                    <Border Background="{DynamicResource Brush.Banner}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.BannerText}"
                                   Text="Яндекс 360 и Mail.ru не принимают обычный пароль от почты в сторонних программах. Создайте «пароль приложения» в настройках безопасности почтового ящика (Яндекс ID → Безопасность → Пароли приложений; Mail.ru → Безопасность → Пароли для внешних приложений) и введите его в поле «Пароль». Также включите доступ по IMAP в настройках почты."/>
                    </Border>
                </StackPanel>

                <Expander Header="Дополнительно" Margin="0,18,0,0" Foreground="{DynamicResource Brush.Text}">
                    <StackPanel Margin="0,4,0,0">
                        <StackPanel x:Name="ExchangeAdvanced">


                        <TextBlock Text="Домен (если не указан в имени пользователя)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DomainBox"/>

                        <TextBlock Text="Общий почтовый ящик (необязательно)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SharedBox" ToolTip="Адрес общего ящика, к которому у вас есть полный доступ, например office@company.ru"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="Если указан, будет открыт этот ящик, а письма будут отправляться от его имени (требуются права «Отправить как»)."/>
                        </StackPanel>

                        <TextBlock Text="Интервал проверки почты" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="IntervalCombo" HorizontalAlignment="Left" MinWidth="200">
                            <ComboBoxItem Content="30 секунд" Tag="30"/>
                            <ComboBoxItem Content="1 минута" Tag="60"/>
                            <ComboBoxItem Content="2 минуты" Tag="120"/>
                            <ComboBoxItem Content="5 минут" Tag="300"/>
                            <ComboBoxItem Content="15 минут" Tag="900"/>
                        </ComboBox>

                        <TextBlock Text="Подпись" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SignatureBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="Безопасность" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,6"
                                   Text="Если сертификат сервера выдан внутренним удостоверяющим центром организации или «Russian Trusted Root CA» (Минцифры России) и не установлен в Windows, импортируйте корневой сертификат здесь. Он будет использоваться только для этого сервера."/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Убрать" Margin="8,0,0,0" Click="ClearCert_Click"/>
                            <Button DockPanel.Dock="Right" Content="Импортировать сертификат…" Margin="8,0,0,0" Click="ImportCert_Click"/>
                            <TextBlock x:Name="CertText" VerticalAlignment="Center" TextWrapping="Wrap" Text="Не задан"/>
                        </DockPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
