<UserControl x:Class="MailClient.App.Views.MessagePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MailClient.App.ViewModels"
             xmlns:ctl="clr-namespace:MailClient.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- A message as shown in the reading pane and in its own window (DataContext: MessagePreviewViewModel). -->
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="PersonTemplate" DataType="{x:Type vm:RecipientItem}">
            <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                <Button Style="{StaticResource NameLink}" Content="{Binding Name}" ToolTip="{Binding ToolTip}" Click="Person_Click"/>
                <TextBlock Text="{Binding Separator}" Foreground="{DynamicResource Brush.TextSecondary}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
    <DockPanel SizeChanged="Root_SizeChanged">
        <!-- header: names only; the address and directory details are in the card opened by a click -->
        <StackPanel DockPanel.Dock="Top" Margin="20,16,20,8">
            <TextBlock Text="{Binding Subject}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding FromInitials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DateText}" Style="{StaticResource Caption}" Margin="8,2,0,0"/>
                        <TextBlock Text="(без отправителя)" FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Visibility="{Binding HasFrom, Converter={StaticResource InvBoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding From}" ItemTemplate="{StaticResource PersonTemplate}" ItemsPanel="{StaticResource WrapItems}"
                                      FontWeight="SemiBold" FontSize="14" Focusable="False"/>
                    </DockPanel>
                    <TextBlock Text="{Binding OnBehalfText}" Style="{StaticResource Caption}" Visibility="{Binding IsSentOnBehalf, Converter={StaticResource BoolToVis}}"/>
                    <!-- Long distribution lists scroll inside a box of at most 15% of the view height (set in code). -->
                    <ScrollViewer x:Name="RecipientsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False" Margin="0,3,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Кому:" Style="{StaticResource Caption}" Margin="0,0,6,0"/>
                                <ItemsControl ItemsSource="{Binding To}" ItemTemplate="{StaticResource PersonTemplate}" ItemsPanel="{StaticResource WrapItems}"
                                              FontSize="12" Focusable="False" AutomationProperties.Name="Кому"/>
                            </DockPanel>
                            <DockPanel Visibility="{Binding HasCc, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Копия:" Style="{StaticResource Caption}" Margin="0,0,6,0"/>
                                <ItemsControl ItemsSource="{Binding Cc}" ItemTemplate="{StaticResource PersonTemplate}" ItemsPanel="{StaticResource WrapItems}"
                                              FontSize="12" Focusable="False" AutomationProperties.Name="Копия"/>
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Text="Высокая важность" Foreground="{DynamicResource Brush.Danger}" FontSize="12" Margin="0,3,0,0"
                               Visibility="{Binding IsHighImportance, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- meeting request -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="20,4,20,6" Padding="12,10"
                Visibility="{Binding IsMeetingRequest, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="20" Margin="0,0,12,0" Foreground="{DynamicResource Brush.Accent}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Принять" Style="{StaticResource AccentButton}" Margin="4,0" Command="{Binding RespondCommand}" CommandParameter="Accept"/>
                    <Button Content="Под вопросом" Margin="4,0" Command="{Binding RespondCommand}" CommandParameter="Tentative"/>
                    <Button Content="Отклонить" Margin="4,0" Command="{Binding RespondCommand}" CommandParameter="Decline"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Приглашение на встречу" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MeetingText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Banner}" Margin="20,4,20,6" Padding="12,8" CornerRadius="6"
                Visibility="{Binding IsMeetingCancellation, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Встреча отменена организатором." Foreground="{DynamicResource Brush.BannerText}"/>
        </Border>

        <!-- blocked remote content -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Banner}" Margin="20,4,20,6" Padding="12,6" CornerRadius="6"
                Visibility="{Binding ShowRemoteBanner, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Показать изображения" Margin="4,0" Padding="10,3" MinHeight="26" Command="{Binding ShowRemoteContentCommand}"/>
                    <Button Content="Всегда для этого отправителя" Margin="4,0" Padding="10,3" MinHeight="26" Command="{Binding TrustSenderCommand}"/>
                </StackPanel>
                <TextBlock Text="Изображения из интернета заблокированы для защиты конфиденциальности." VerticalAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.BannerText}"/>
            </DockPanel>
        </Border>

        <!-- attachments -->
        <DockPanel DockPanel.Dock="Top" Margin="18,2,18,8" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Tag="&#xE896;" Content="Сохранить все"
                    VerticalAlignment="Top" Command="{Binding SaveAllAttachmentsCommand}"/>
            <ScrollViewer x:Name="AttachmentsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Attachments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AttachmentItemViewModel}">
                            <Border Style="{StaticResource Card}" Margin="2" Padding="0" CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ToolButton}" Tag="{Binding Icon}" ToolTip="Открыть"
                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel MaxWidth="220">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Tag="&#xE896;" ToolTip="Сохранить как…" Padding="6,4"
                                            Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <ctl:MessageBodyView x:Name="Body" Html="{Binding Html}"/>
        </Border>
    </DockPanel>

    <!-- Contact card (a Popup, so it is drawn over the WebView2 body). DataContext: ContactCardViewModel, set in code. -->
    <Popup x:Name="CardPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade" VerticalOffset="2"
           HorizontalOffset="-12">
        <Border Style="{StaticResource Card}" Margin="12,4,12,16" Padding="16,14,16,12" Width="360" PreviewKeyDown="Card_PreviewKeyDown"
                d:DataContext="{d:DesignInstance vm:ContactCardViewModel}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.22"/>
            </Border.Effect>
            <StackPanel>
                <DockPanel>
                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBox Text="{Binding DisplayName, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="16" FontWeight="SemiBold"
                                 AutomationProperties.Name="Имя"/>
                        <TextBlock Text="{Binding JobText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding HasJob, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Company}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding HasCompany, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DockPanel>

                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,12,0,8"/>

                <DockPanel Margin="0,3" Visibility="{Binding HasEmail, Converter={StaticResource BoolToVis}}" ToolTip="Электронная почта">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE715;" Width="26" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBox Text="{Binding Email, Mode=OneWay}" Style="{StaticResource SelectableText}" AutomationProperties.Name="Электронная почта"/>
                </DockPanel>
                <DockPanel Margin="0,3" Visibility="{Binding HasBusinessPhone, Converter={StaticResource BoolToVis}}" ToolTip="Рабочий телефон">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE717;" Width="26" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBox Text="{Binding BusinessPhone, Mode=OneWay}" Style="{StaticResource SelectableText}" AutomationProperties.Name="Рабочий телефон"/>
                </DockPanel>
                <DockPanel Margin="0,3" Visibility="{Binding HasMobilePhone, Converter={StaticResource BoolToVis}}" ToolTip="Мобильный телефон">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" Width="26" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBox Text="{Binding MobilePhone, Mode=OneWay}" Style="{StaticResource SelectableText}" AutomationProperties.Name="Мобильный телефон"/>
                </DockPanel>
                <TextBlock Text="Поиск в адресной книге…" Style="{StaticResource Caption}" Margin="26,3,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="CardWriteButton" Style="{StaticResource AccentButton}" Margin="0,0,6,4" Command="{Binding WriteCommand}"
                            Click="CardAction_Click" IsEnabled="{Binding HasEmail}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="13" Margin="0,0,7,0" Foreground="{DynamicResource Brush.AccentText}"/>
                            <TextBlock Text="Написать"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE8C8;" Content="Копировать адрес" Margin="0,0,4,4"
                            Command="{Binding CopyAddressCommand}" Click="CardAction_Click" IsEnabled="{Binding HasEmail}"/>
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE8FA;" Content="В контакты" Margin="0,0,0,4" ToolTip="Добавить в мои контакты"
                            Command="{Binding AddToContactsCommand}" Click="CardAction_Click"
                            Visibility="{Binding CanAddToContacts, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</UserControl>
