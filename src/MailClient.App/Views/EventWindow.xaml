<Window x:Class="MailClient.App.Views.EventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="Новое событие" Icon="/Assets/app.ico"
        Width="560" Height="640" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="Сохранить" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="110" Click="Ok_Click"/>
                <Button Content="Отмена" IsCancel="True" MinWidth="90" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16">
                <TextBlock Text="Тема" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="SubjectBox" FontWeight="SemiBold"/>
                <TextBlock Text="Место" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="LocationBox" ToolTip="Переговорная, адрес или ссылка на видеоконференцию"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Дата" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DatePick" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Начало" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="StartCombo" IsEditable="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Окончание" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="EndCombo" IsEditable="True"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="AllDayCheck" Content="Весь день" Margin="0,10,0,0" Checked="AllDay_Changed" Unchecked="AllDay_Changed"/>

                <TextBlock Text="Показывать как" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="BusyCombo" HorizontalAlignment="Left" MinWidth="200">
                    <ComboBoxItem Content="Занят" Tag="Busy"/>
                    <ComboBoxItem Content="Под вопросом" Tag="Tentative"/>
                    <ComboBoxItem Content="Свободен" Tag="Free"/>
                    <ComboBoxItem Content="Нет на месте" Tag="OOF"/>
                </ComboBox>

                <TextBlock Text="Напоминание" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ReminderCombo" HorizontalAlignment="Left" MinWidth="200">
                    <ComboBoxItem Content="Нет" Tag="-1"/>
                    <ComboBoxItem Content="За 5 минут" Tag="5"/>
                    <ComboBoxItem Content="За 15 минут" Tag="15"/>
                    <ComboBoxItem Content="За 30 минут" Tag="30"/>
                    <ComboBoxItem Content="За 1 час" Tag="60"/>
                    <ComboBoxItem Content="За 1 день" Tag="1440"/>
                </ComboBox>

                <TextBlock Text="Участники (обязательные), через «;»" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="RequiredBox" ToolTip="Если указаны участники, им будут отправлены приглашения"/>
                <TextBlock Text="Участники (необязательные)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="OptionalBox"/>

                <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
