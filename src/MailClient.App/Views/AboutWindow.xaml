<Window x:Class="MailClient.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="О программе" Icon="/Assets/app.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="28,24">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/app.ico" Width="48" Height="48"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Корпоративная почта" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Caption}"/>
            </StackPanel>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,16,0,0"
                   Text="Почтовый клиент для Microsoft Exchange Server 2010 SP2 – Subscription Edition (протокол EWS): почта, папки, вложения, календарь, контакты, адресная книга организации, задачи и автоответы."/>
        <TextBlock x:Name="PathsText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <Button Content="Закрыть" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="90" Margin="0,18,0,0"/>
    </StackPanel>
</Window>
