<Window x:Class="MailClient.App.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MailClient.App.Views"
        Style="{StaticResource AppWindow}" Icon="/Assets/app.ico" Width="900" Height="720" MinWidth="560" MinHeight="400"
        Title="{Binding Subject}" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Background="{DynamicResource Brush.Surface}">
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6" Background="{DynamicResource Brush.SurfaceAlt}">
            <WrapPanel>
                <Button Style="{StaticResource ToolButton}" Tag="&#xE8CA;" Content="Ответить" Click="Reply_Click" ToolTip="Ответить (Ctrl+R)"/>
                <Button Style="{StaticResource ToolButton}" Tag="&#xE8C2;" Content="Ответить всем" Click="ReplyAll_Click" ToolTip="Ответить всем (Ctrl+Shift+R)"/>
                <Button Style="{StaticResource ToolButton}" Tag="&#xE89C;" Content="Переслать" Click="Forward_Click" ToolTip="Переслать (Ctrl+F)"/>
                <Rectangle Width="1" Height="20" Margin="6,0" Fill="{DynamicResource Brush.Border}"/>
                <Button Style="{StaticResource ToolButton}" Tag="&#xE749;" Content="Печать" Click="Print_Click" ToolTip="Печать (Ctrl+P)"/>
            </WrapPanel>
        </Border>
        <local:MessagePreviewView x:Name="PreviewView"/>
    </DockPanel>
</Window>
