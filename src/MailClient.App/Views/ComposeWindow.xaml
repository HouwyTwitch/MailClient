<Window x:Class="MailClient.App.Views.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MailClient.App.ViewModels"
        xmlns:ctl="clr-namespace:MailClient.App.Controls"
        Style="{StaticResource AppWindow}"
        Title="{Binding WindowTitle}" Icon="/Assets/app.ico"
        Width="940" Height="720" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <DataTemplate x:Key="PaletteItem" DataType="{x:Type vm:PaletteColor}">
            <Button Style="{StaticResource PaletteSwatch}" Background="{Binding Brush}" ToolTip="{Binding Name}"
                    AutomationProperties.Name="{Binding Name}" Click="PaletteColor_Click"/>
        </DataTemplate>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}"/>
        <KeyBinding Gesture="Alt+S" Command="{Binding SendCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveDraftCommand}"/>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding CheckNamesCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <Button Style="{StaticResource AccentButton}" Command="{Binding SendCommand}" Height="34" Padding="18,4" ToolTip="Отправить (Ctrl+Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="14" Foreground="{DynamicResource Brush.AccentText}"/>
                        <TextBlock Text="Отправить" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Tag="&#xE74E;" Content="Сохранить" Command="{Binding SaveDraftCommand}" Margin="8,0,0,0" ToolTip="Сохранить черновик (Ctrl+S)"/>
                <Button Style="{StaticResource ToolButton}" Tag="&#xE723;" Content="Вложить файл" Click="Attach_Click"/>
                <Button Style="{StaticResource ToolButton}" Tag="&#xE8D4;" Content="Проверить имена" Command="{Binding CheckNamesCommand}" ToolTip="Проверить имена по адресной книге (Ctrl+K)"/>
                <CheckBox Content="Важное" IsChecked="{Binding HighImportance}" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Высокая важность"/>
                <CheckBox Content="Уведомить о прочтении" IsChecked="{Binding RequestReadReceipt}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ProgressBar Width="80" Height="4" IsIndeterminate="True" Margin="0,0,8,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- header fields -->
        <Grid DockPanel.Dock="Top" Margin="14,8,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="От:" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="13"
                       Visibility="{Binding HasMultipleAccounts, Converter={StaticResource BoolToVis}}"/>
            <ComboBox AutomationProperties.Name="От" Grid.Column="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Margin="0,2" HorizontalAlignment="Left" MinWidth="300"
                      Visibility="{Binding HasMultipleAccounts, Converter={StaticResource BoolToVis}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Settings.EmailAddress}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="1" Text="Кому:" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="13"/>
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,2">
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Скрытая копия" Command="{Binding ToggleBccCommand}"
                        Visibility="{Binding ShowBcc, Converter={StaticResource InvBoolToVis}}"/>
                <TextBox x:Name="ToBox" AutomationProperties.Name="Кому" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" ToolTip="Адреса через «;». Можно ввести имя — оно будет найдено в адресной книге."/>
            </DockPanel>

            <TextBlock Grid.Row="2" Text="Копия:" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="13"/>
            <TextBox x:Name="CcBox" AutomationProperties.Name="Копия" Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding Cc, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Text="Скрытая:" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="13"
                       Visibility="{Binding ShowBcc, Converter={StaticResource BoolToVis}}"/>
            <TextBox x:Name="BccBox" AutomationProperties.Name="Скрытая копия" Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding Bcc, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding ShowBcc, Converter={StaticResource BoolToVis}}"/>

            <TextBlock Grid.Row="4" Text="Тема:" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="13"/>
            <TextBox x:Name="SubjectBox" AutomationProperties.Name="Тема" Grid.Row="4" Grid.Column="1" Margin="0,2" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"/>
        </Grid>

        <!-- attachments -->
        <DockPanel DockPanel.Dock="Top" Margin="14,6,14,0" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding AttachmentsSummary}" Style="{StaticResource Caption}" Margin="2,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Attachments}" MaxHeight="96">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ComposeAttachment}">
                        <Border Style="{StaticResource Card}" Margin="2" Padding="10,4,2,4" CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE723;" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource ToolButton}" Tag="&#xE711;" Padding="5,2" MinHeight="22" ToolTip="Убрать вложение"
                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- formatting -->
        <Border x:Name="FormatBar" DockPanel.Dock="Top" Margin="14,8,14,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,5">
            <WrapPanel>
                <WrapPanel.Resources>
                    <Style TargetType="Rectangle">
                        <Setter Property="Width" Value="1"/>
                        <Setter Property="Height" Value="18"/>
                        <Setter Property="Margin" Value="6,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Fill" Value="{DynamicResource Brush.Border}"/>
                    </Style>
                </WrapPanel.Resources>

                <ComboBox x:Name="FontCombo" Width="160" MinHeight="28" Padding="8,3,26,3" MaxDropDownHeight="380"
                          ToolTip="Шрифт" AutomationProperties.Name="Шрифт" SelectionChanged="FontCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="13"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox x:Name="SizeCombo" Width="66" MinHeight="28" Padding="8,3,24,3" Margin="4,0,0,0" MaxDropDownHeight="380"
                          ItemStringFormat="{}{0:0.#}" ToolTip="Размер шрифта (пт)" AutomationProperties.Name="Размер шрифта"
                          SelectionChanged="SizeCombo_SelectionChanged"/>
                <Rectangle/>

                <ToggleButton x:Name="BoldButton" Style="{StaticResource FormatButton}" Tag="bold" Click="Toggle_Click"
                              ToolTip="Полужирный (Ctrl+B)" AutomationProperties.Name="Полужирный">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DD;" FontSize="14"/>
                </ToggleButton>
                <ToggleButton x:Name="ItalicButton" Style="{StaticResource FormatButton}" Tag="italic" Click="Toggle_Click"
                              ToolTip="Курсив (Ctrl+I)" AutomationProperties.Name="Курсив">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DB;" FontSize="14"/>
                </ToggleButton>
                <ToggleButton x:Name="UnderlineButton" Style="{StaticResource FormatButton}" Tag="underline" Click="Toggle_Click"
                              ToolTip="Подчёркнутый (Ctrl+U)" AutomationProperties.Name="Подчёркнутый">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DC;" FontSize="14"/>
                </ToggleButton>
                <ToggleButton x:Name="StrikeButton" Style="{StaticResource FormatButton}" Tag="strikeThrough" Click="Toggle_Click"
                              ToolTip="Зачёркнутый" AutomationProperties.Name="Зачёркнутый">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEDE0;" FontSize="14"/>
                </ToggleButton>
                <Rectangle/>

                <!-- text colour -->
                <ToggleButton x:Name="ColorButton" Style="{StaticResource FormatButton}" Width="38"
                              IsHitTestVisible="{Binding IsOpen, ElementName=ColorPopup, Converter={StaticResource InvBool}}"
                              ToolTip="Цвет текста" AutomationProperties.Name="Цвет текста">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="18">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8D3;" FontSize="13" VerticalAlignment="Top"/>
                            <Rectangle x:Name="ColorSwatch" Height="3" VerticalAlignment="Bottom" Fill="#C00000" Style="{x:Null}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Margin="3,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       IsOpen="{Binding IsChecked, ElementName=ColorButton, Mode=TwoWay}">
                    <Border Style="{StaticResource PalettePopup}">
                        <StackPanel>
                            <Button Style="{StaticResource PaletteTextButton}" Content="Автоматический" Click="ColorAuto_Click"/>
                            <ItemsControl x:Name="ColorPalette" Style="{StaticResource Palette}" ItemTemplate="{StaticResource PaletteItem}"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- highlight -->
                <ToggleButton x:Name="HighlightButton" Style="{StaticResource FormatButton}" Width="38"
                              IsHitTestVisible="{Binding IsOpen, ElementName=HighlightPopup, Converter={StaticResource InvBool}}"
                              ToolTip="Цвет выделения текста" AutomationProperties.Name="Цвет выделения текста">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="18">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7E6;" FontSize="13" VerticalAlignment="Top"/>
                            <Rectangle x:Name="HighlightSwatch" Height="3" VerticalAlignment="Bottom" Fill="#FFFF00" Style="{x:Null}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Margin="3,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="HighlightPopup" PlacementTarget="{Binding ElementName=HighlightButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       IsOpen="{Binding IsChecked, ElementName=HighlightButton, Mode=TwoWay}">
                    <Border Style="{StaticResource PalettePopup}">
                        <StackPanel>
                            <Button Style="{StaticResource PaletteTextButton}" Content="Без выделения" Click="HighlightNone_Click"/>
                            <ItemsControl x:Name="HighlightPalette" Style="{StaticResource Palette}" ItemTemplate="{StaticResource PaletteItem}"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Rectangle/>

                <ToggleButton x:Name="AlignLeftButton" Style="{StaticResource FormatButton}" Tag="justifyLeft" Click="Toggle_Click"
                              ToolTip="По левому краю" AutomationProperties.Name="По левому краю">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8E4;" FontSize="14"/>
                </ToggleButton>
                <ToggleButton x:Name="AlignCenterButton" Style="{StaticResource FormatButton}" Tag="justifyCenter" Click="Toggle_Click"
                              ToolTip="По центру" AutomationProperties.Name="По центру">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8E3;" FontSize="14"/>
                </ToggleButton>
                <ToggleButton x:Name="AlignRightButton" Style="{StaticResource FormatButton}" Tag="justifyRight" Click="Toggle_Click"
                              ToolTip="По правому краю" AutomationProperties.Name="По правому краю">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8E2;" FontSize="14"/>
                </ToggleButton>
                <ToggleButton x:Name="JustifyButton" Style="{StaticResource FormatButton}" Tag="justifyFull" Click="Toggle_Click"
                              ToolTip="По ширине" AutomationProperties.Name="По ширине">
                    <Path Style="{StaticResource PathIcon}" Data="{StaticResource Geo.Justify}"/>
                </ToggleButton>
                <Rectangle/>

                <ToggleButton x:Name="BulletsButton" Style="{StaticResource FormatButton}" Tag="insertUnorderedList" Click="Toggle_Click"
                              ToolTip="Маркированный список" AutomationProperties.Name="Маркированный список">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="14"/>
                </ToggleButton>
                <ToggleButton x:Name="NumbersButton" Style="{StaticResource FormatButton}" Tag="insertOrderedList" Click="Toggle_Click"
                              ToolTip="Нумерованный список" AutomationProperties.Name="Нумерованный список">
                    <Path Style="{StaticResource PathIcon}" Data="{StaticResource Geo.NumberedList}" StrokeThickness="1.1"/>
                </ToggleButton>
                <Button Style="{StaticResource FormatButton}" Tag="outdent" Click="Command_Click"
                        ToolTip="Уменьшить отступ" AutomationProperties.Name="Уменьшить отступ">
                    <Path Style="{StaticResource PathIcon}" Data="{StaticResource Geo.Outdent}"/>
                </Button>
                <Button Style="{StaticResource FormatButton}" Tag="indent" Click="Command_Click"
                        ToolTip="Увеличить отступ" AutomationProperties.Name="Увеличить отступ">
                    <Path Style="{StaticResource PathIcon}" Data="{StaticResource Geo.Indent}"/>
                </Button>
                <Rectangle/>

                <Button Style="{StaticResource FormatButton}" Click="Link_Click" ToolTip="Вставить ссылку" AutomationProperties.Name="Вставить ссылку">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource FormatButton}" Click="Image_Click" ToolTip="Вставить изображение в текст" AutomationProperties.Name="Вставить изображение">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE91B;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource FormatButton}" Tag="insertHorizontalRule" Click="Command_Click"
                        ToolTip="Горизонтальная линия" AutomationProperties.Name="Горизонтальная линия">
                    <Path Style="{StaticResource PathIcon}" Data="{StaticResource Geo.HorizontalRule}"/>
                </Button>
                <Rectangle/>

                <Button x:Name="UndoButton" Style="{StaticResource FormatButton}" Tag="undo" Click="Command_Click"
                        ToolTip="Отменить (Ctrl+Z)" AutomationProperties.Name="Отменить">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="14"/>
                </Button>
                <Button x:Name="RedoButton" Style="{StaticResource FormatButton}" Tag="redo" Click="Command_Click"
                        ToolTip="Повторить (Ctrl+Y)" AutomationProperties.Name="Повторить">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource FormatButton}" Tag="removeFormat" Click="Command_Click"
                        ToolTip="Очистить форматирование" AutomationProperties.Name="Очистить форматирование">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE75C;" FontSize="14"/>
                </Button>
            </WrapPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding QuoteNote}" Style="{StaticResource Caption}" Margin="16,6"
                   Visibility="{Binding HasQuoteNote, Converter={StaticResource BoolToVis}}"/>

        <Grid>
            <ctl:HtmlEditor x:Name="Editor" Margin="4,0" AutomationProperties.Name="Текст письма"/>
            <Popup x:Name="SuggestPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="2" MinWidth="360" MaxHeight="320">
                    <ListBox x:Name="SuggestList" MouseUp="SuggestList_MouseUp" KeyDown="SuggestList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,5">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="{Binding PrimaryEmail, Mode=OneWay}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Department, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</Window>
