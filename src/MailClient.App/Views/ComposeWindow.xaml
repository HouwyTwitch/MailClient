<Window x:Class="MailClient.App.Views.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MailClient.App.ViewModels"
        xmlns:ctl="clr-namespace:MailClient.App.Controls"
        Style="{StaticResource AppWindow}"
        Title="{Binding WindowTitle}" Icon="/Assets/app.ico"
        Width="940" Height="720" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}"/>
        <KeyBinding Gesture="Alt+S" Command="{Binding SendCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveDraftCommand}"/>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding CheckNamesCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <Button Style="{StaticResource AccentButton}" Command="{Binding SendCommand}" Height="34" Padding="18,4" ToolTip="Отправить (Ctrl+Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="14" Foreground="{DynamicResource Brush.AccentText}"/>
                        <TextBlock Text="Отправить" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Tag="&#xE74E;" Content="Сохранить" Command="{Binding SaveDraftCommand}" Margin="8,0,0,0" ToolTip="Сохранить черновик (Ctrl+S)"/>
                <Button Style="{StaticResource ToolButton}" Tag="&#xE723;" Content="Вложить файл" Click="Attach_Click"/>
                <Button Style="{StaticResource ToolButton}" Tag="&#xE8D4;" Content="Проверить имена" Command="{Binding CheckNamesCommand}" ToolTip="Проверить имена по адресной книге (Ctrl+K)"/>
                <Button x:Name="SignatureButton" Style="{StaticResource ToolButton}" Tag="&#xE70F;" Content="Подпись" Click="Signature_Click"
                        ToolTip="Вставить, убрать или изменить подпись">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Вставить подпись" Click="InsertSignature_Click"/>
                            <MenuItem Header="Убрать подпись" Click="RemoveSignature_Click"/>
                            <Separator/>
                            <MenuItem Header="Изменить подпись…" Click="EditSignature_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <CheckBox Content="Важное" IsChecked="{Binding HighImportance}" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Высокая важность"/>
                <CheckBox Content="Уведомить о прочтении" IsChecked="{Binding RequestReadReceipt}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ProgressBar Width="80" Height="4" IsIndeterminate="True" Margin="0,0,8,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- header fields -->
        <Grid DockPanel.Dock="Top" Margin="14,8,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="От:" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="13"
                       Visibility="{Binding HasMultipleAccounts, Converter={StaticResource BoolToVis}}"/>
            <ComboBox AutomationProperties.Name="От" Grid.Column="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Margin="0,2" HorizontalAlignment="Left" MinWidth="300"
                      Visibility="{Binding HasMultipleAccounts, Converter={StaticResource BoolToVis}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Settings.EmailAddress}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="1" Text="Кому:" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="13"/>
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,2">
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Скрытая копия" Command="{Binding ToggleBccCommand}"
                        Visibility="{Binding ShowBcc, Converter={StaticResource InvBoolToVis}}"/>
                <TextBox x:Name="ToBox" AutomationProperties.Name="Кому" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" ToolTip="Адреса через «;». Можно ввести имя — оно будет найдено в адресной книге."/>
            </DockPanel>

            <TextBlock Grid.Row="2" Text="Копия:" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="13"/>
            <TextBox x:Name="CcBox" AutomationProperties.Name="Копия" Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding Cc, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Text="Скрытая:" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="13"
                       Visibility="{Binding ShowBcc, Converter={StaticResource BoolToVis}}"/>
            <TextBox x:Name="BccBox" AutomationProperties.Name="Скрытая копия" Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding Bcc, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding ShowBcc, Converter={StaticResource BoolToVis}}"/>

            <TextBlock Grid.Row="4" Text="Тема:" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="13"/>
            <TextBox x:Name="SubjectBox" AutomationProperties.Name="Тема" Grid.Row="4" Grid.Column="1" Margin="0,2" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"/>
        </Grid>

        <!-- attachments -->
        <DockPanel DockPanel.Dock="Top" Margin="14,6,14,0" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding AttachmentsSummary}" Style="{StaticResource Caption}" Margin="2,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Attachments}" MaxHeight="96">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ComposeAttachment}">
                        <Border Style="{StaticResource Card}" Margin="2" Padding="10,4,2,4" CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE723;" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource ToolButton}" Tag="&#xE711;" Padding="5,2" MinHeight="22" ToolTip="Убрать вложение"
                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- formatting -->
        <Border x:Name="FormatBar" DockPanel.Dock="Top" Margin="14,8,14,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,5">
            <ctl:FormattingBar x:Name="Formatting"/>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding QuoteNote}" Style="{StaticResource Caption}" Margin="16,6"
                   Visibility="{Binding HasQuoteNote, Converter={StaticResource BoolToVis}}"/>

        <Grid>
            <ctl:HtmlEditor x:Name="Editor" Margin="4,0" AutomationProperties.Name="Текст письма"/>
            <Popup x:Name="SuggestPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="2" MinWidth="360" MaxHeight="320">
                    <ListBox x:Name="SuggestList" MouseUp="SuggestList_MouseUp" KeyDown="SuggestList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,5">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="{Binding PrimaryEmail, Mode=OneWay}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Department, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</Window>
