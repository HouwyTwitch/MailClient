<Window x:Class="MailClient.App.Views.OofWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="Автоматические ответы" Icon="/Assets/app.ico"
        Width="600" Height="700" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Сохранить" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="110" Click="Save_Click" IsEnabled="False"/>
                <Button Content="Отмена" IsCancel="True" MinWidth="90" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Form" Margin="24,16" IsEnabled="False">
                <TextBlock Text="Автоматические ответы (нет на месте)" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="LoadingText" Text="Загрузка настроек с сервера…" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                <RadioButton x:Name="OffRadio" Content="Не отправлять автоматические ответы" Margin="0,14,0,0" GroupName="state"/>
                <RadioButton x:Name="OnRadio" Content="Отправлять автоматические ответы" GroupName="state"/>
                <RadioButton x:Name="ScheduledRadio" Content="Отправлять только в указанный период" GroupName="state"/>
                <Grid Margin="24,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker x:Name="StartDate" Grid.Column="1" Margin="0,3"/>
                    <TextBox x:Name="StartTime" Grid.Column="2" Margin="6,3,0,3"/>
                    <TextBlock Grid.Row="1" Text="По:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker x:Name="EndDate" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                    <TextBox x:Name="EndTime" Grid.Row="1" Grid.Column="2" Margin="6,3,0,3"/>
                </Grid>

                <TextBlock Text="Ответ сотрудникам организации" Style="{StaticResource SectionHeader}"/>
                <TextBox x:Name="InternalBox" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalContentAlignment="Top" Margin="0,6,0,0"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Ответ внешним отправителям" Style="{StaticResource SectionHeader}"/>
                <ComboBox x:Name="AudienceCombo" Margin="0,6,0,0" HorizontalAlignment="Left" MinWidth="320">
                    <ComboBoxItem Content="Не отвечать внешним отправителям" Tag="None"/>
                    <ComboBoxItem Content="Только моим контактам" Tag="Known"/>
                    <ComboBoxItem Content="Всем внешним отправителям" Tag="All"/>
                </ComboBox>
                <TextBox x:Name="ExternalBox" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalContentAlignment="Top" Margin="0,8,0,0"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
