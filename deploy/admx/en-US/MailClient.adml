<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Corporate Mail</displayName>
  <description>Administrative templates for the Corporate Mail client.</description>
  <resources>
    <stringTable>
      <string id="Category_MailClient">Corporate Mail</string>
      <string id="SUPPORTED_MailClient">Corporate Mail 0.1 and later</string>
      <string id="EwsUrl">Exchange server address (EWS)</string>
      <string id="EwsUrl_Help">Exchange Web Services URL, e.g. https://mail.company.ru/EWS/Exchange.asmx. Pre-filled when an account is added, so users only enter their login and password.</string>
      <string id="Domain">Windows sign-in domain</string>
      <string id="Domain_Help">Domain added to the user name when signing in to Exchange (e.g. CORP).</string>
      <string id="EmailDomain">Mail domain</string>
      <string id="EmailDomain_Help">Lets users type only a name (ivanov); the address is completed to ivanov@domain.</string>
      <string id="AuthMethod">Exchange sign-in method</string>
      <string id="AuthMethod_Help">Password, or IntegratedWindows (single sign-on with the Windows account on domain computers).</string>
      <string id="AuthMethod_Password">Login and password</string>
      <string id="AuthMethod_IntegratedWindows">Windows single sign-on</string>
      <string id="ServerVersion">Exchange Server version</string>
      <string id="ServerVersion_Help">EWS protocol version. Exchange 2016 fits 2016, 2019 and Subscription Edition.</string>
      <string id="ServerVersion_Exchange2016">Exchange 2016 / 2019 / Subscription Edition</string>
      <string id="ServerVersion_Exchange2013_SP1">Exchange 2013 SP1</string>
      <string id="ServerVersion_Exchange2013">Exchange 2013</string>
      <string id="ServerVersion_Exchange2010_SP2">Exchange 2010 SP2</string>
      <string id="TrustedRootCertificateFile">Organization root certificate</string>
      <string id="TrustedRootCertificateFile_Help">Path to the root certificate of the internal CA or the Russian Trusted Root CA (.cer, .crt, .pem). It is trusted for the mail server only and not installed into the Windows store.</string>
      <string id="LockServerSettings">Prevent changing the server address</string>
      <string id="LockServerSettings_Help">When enabled, users cannot change the Exchange server address set by the "Exchange server address (EWS)" policy.</string>
      <string id="Protocol">Default account type</string>
      <string id="Protocol_Help">Exchange (EWS) or IMAP/SMTP.</string>
      <string id="Protocol_Exchange">Microsoft Exchange</string>
      <string id="Protocol_Imap">IMAP / SMTP</string>
      <string id="ImapHost">IMAP server</string>
      <string id="ImapHost_Help">IMAP server address for IMAP accounts.</string>
      <string id="ImapPort">IMAP port</string>
      <string id="ImapPort_Help">993 uses SSL/TLS, other ports STARTTLS.</string>
      <string id="SmtpHost">SMTP server</string>
      <string id="SmtpHost_Help">Outgoing mail server for IMAP accounts.</string>
      <string id="SmtpPort">SMTP port</string>
      <string id="SmtpPort_Help">465 uses SSL/TLS, other ports STARTTLS.</string>
      <string id="DisableForwardingRules">Prevent forwarding rules</string>
      <string id="DisableForwardingRules_Help">When enabled, the Forwarding rules window is unavailable and users cannot set up forwarding or redirection in the client. To enforce this in other clients too (Outlook, OWA), restrict automatic forwarding on the Exchange server (remote domains, transport rules).</string>
    </stringTable>
    <presentationTable>
      <presentation id="EwsUrl"><textBox refId="EwsUrl"><label>EWS URL:</label></textBox></presentation>
      <presentation id="Domain"><textBox refId="Domain"><label>Domain:</label></textBox></presentation>
      <presentation id="EmailDomain"><textBox refId="EmailDomain"><label>Mail domain:</label></textBox></presentation>
      <presentation id="AuthMethod"><dropdownList refId="AuthMethod" noSort="true">Sign-in method:</dropdownList></presentation>
      <presentation id="ServerVersion"><dropdownList refId="ServerVersion" noSort="true">Version:</dropdownList></presentation>
      <presentation id="TrustedRootCertificateFile"><textBox refId="TrustedRootCertificateFile"><label>File path:</label></textBox></presentation>
      <presentation id="Protocol"><dropdownList refId="Protocol" noSort="true">Type:</dropdownList></presentation>
      <presentation id="ImapHost"><textBox refId="ImapHost"><label>IMAP server:</label></textBox></presentation>
      <presentation id="ImapPort"><decimalTextBox refId="ImapPort" defaultValue="993">IMAP port:</decimalTextBox></presentation>
      <presentation id="SmtpHost"><textBox refId="SmtpHost"><label>SMTP server:</label></textBox></presentation>
      <presentation id="SmtpPort"><decimalTextBox refId="SmtpPort" defaultValue="587">SMTP port:</decimalTextBox></presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
