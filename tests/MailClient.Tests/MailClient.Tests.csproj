<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are executables, run through Microsoft.Testing.Platform (see global.json). -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MailClient.Core\MailClient.Core.csproj" />
    <ProjectReference Include="..\..\src\MailClient.Exchange\MailClient.Exchange.csproj" />
    <ProjectReference Include="..\..\src\MailClient.Imap\MailClient.Imap.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="EwsRequestRules.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
